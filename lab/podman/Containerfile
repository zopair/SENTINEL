# Minimal runtime for the synthetic SENTINEL CLI only.
# This image does not contain or launch external security agents.
FROM python:3.12-alpine

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app
COPY sentinel/ /app/sentinel/

USER 10001:10001
ENTRYPOINT ["python", "-m", "sentinel.cli"]
